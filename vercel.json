{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/LinkFoco/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/linkfoco/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/s/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/demo/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/:slug((?!api$|admin$|painel$|dashboard$|login$|logout$|auth$|signin$|signup$|register$|oauth$|callback$|assets$|uploads$|public$|static$|health$|q$|m$|demo$|site$|s$|linkfoco$|minisites$|minisite$|criar-minisite$|prospeccao$|crm$|qr-codes$|qrcodes$|scripts$|configuracoes$|config$|empresas$|equipe$|logs$|diagnosticos$|propostas$|whatsapp$|fluxos$|agenda$|projetos$|clientes$|cobrancas$|relatorios$|integracoes$|ajuda$)[a-z0-9-]{3,64})",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(LinkFoco|linkfoco|s|demo)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
