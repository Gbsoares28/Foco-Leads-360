# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Server-side Google Maps Platform Places API (New) key.
# Provisioned automatically in AI Studio via the Google Maps setup panel.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_BASE_URL / VITE_PUBLIC_BASE_URL: Origem pública canônica dos minisites (/<slug>, ex: https://linkfoco.vercel.app/nosso-pet-favorito).
# Padrão canônico: https://linkfoco.vercel.app (nunca use URLs temporárias ais-dev em produção).
PUBLIC_BASE_URL="https://linkfoco.vercel.app"
VITE_PUBLIC_BASE_URL="https://linkfoco.vercel.app"
MINISITE_BASE_DOMAIN="linkfoco.vercel.app"

# Backend only. Generate fresh values before deploying.
SESSION_SECRET=
ADMIN_PASSWORD=
